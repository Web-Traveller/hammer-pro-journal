{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hammer Pro Journal",
  "version": "2.2.0",
  "identifier": "com.hammerpro.journal",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Hammer Pro Journal",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "Hammer Pro Trading LLC",
    "copyright": "Copyright © 2026 Hammer Pro",
    "category": "Finance",
    "shortDescription": "Level 2 tape scalper trading journal & performance analytics",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQxODA3NjJGN0UzRjg3NjkKUldScGh6OStMM2FBUVRqNjlDTUxieDNWb0R1MVpMUnhCYTFoZFJyb3cxc2g2QllDdjVHVHkzaGMK",
      "endpoints": [
        "https://qvzttflsjcgndjusvykq.supabase.co/storage/v1/object/public/releases/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}