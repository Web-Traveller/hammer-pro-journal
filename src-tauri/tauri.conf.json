  "productName": "Hammer Pro Journal",
  "version": "1.0.1",
  "identifier": "com.hammerpro.journal",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
